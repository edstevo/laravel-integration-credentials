{
    "name": "edstevo/laravel-integration-credentials",
    "description": "A small package to store integration credentials against Laravel models",
    "keywords": [
        "edstevo",
        "laravel",
        "laravel-integration-credentials"
    ],
    "homepage": "https://github.com/edstevo/laravel-integration-credentials",
    "license": "MIT",
    "authors": [
        {
            "name": "Edward Stephenson",
            "email": "edward.stephenson@me.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93",
        "illuminate/contracts": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "EdStevo\\LaravelIntegrationCredentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdStevo\\LaravelIntegrationCredentials\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress --debug",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdStevo\\LaravelIntegrationCredentials\\LaravelIntegrationCredentialsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
